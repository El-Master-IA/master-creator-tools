{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!masterplan",
			"!**/dist",
			"!**/.mct",
			"!**/.vitest",
			"!**/node_modules",
			"!**/test-results",
			"!**/playwright-report",
			"!**/*.md"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true
	}
}
